---
import '../styles/global.scss';
import { ClientRouter } from 'astro:transitions';
import SplashLoader from '../components/SplashLoader.tsx';
import WhatsAppFloat from '../components/WhatsAppFloat.tsx';
import { getPageContent } from '../lib/pages';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Your English Buddy',
  description = 'Aprende inglés de forma práctica, clara y personalizada con Your English Buddy.',
} = Astro.props;

// CMS-managed chrome for the floating WhatsApp FAB (cached in lib/pages, so
// this doesn't duplicate the page's own 'site' fetch within a request burst).
const site = await getPageContent('site');
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <!-- SPA-like navigation + animated page swaps + scroll reset -->
    <ClientRouter />
  </head>
  <body>
    <!-- Global chrome: persist across client-side navigations so the splash
         session-guard and the floating button don't re-mount on every nav. -->
    <SplashLoader client:load transition:persist />
    <slot />
    <WhatsAppFloat client:idle transition:persist site={site} />
  </body>
</html>
