---
// Admin panel — a client-only React SPA (react-router handles all /admin/*
// sub-routes). SSR-rendered shell only; no data is fetched on the server.
export const prerender = false;

import '../../styles/global.scss';
import AdminApp from '../../admin/AdminApp.tsx';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- Public Sans: the admin dashboard typeface (public site keeps Poppins/Jakarta) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <title>Admin · Your English Buddy</title>
  </head>
  <body>
    <AdminApp client:only="react" />
  </body>
</html>
