---
// Blog listing — SSR (on-demand) so the CMS stays fresh without a rebuild.
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.tsx';
import BlogSection from '../../components/BlogSection.tsx';
import Footer from '../../components/Footer.tsx';
import { getPosts } from '../../lib/api';
import type { BlogListItemDto } from '@eyb/shared';

let posts: BlogListItemDto[] = [];
try {
  posts = await getPosts();
} catch (err) {
  console.error('[blog] failed to load posts from API:', err);
}
---

<BaseLayout title="Blog — Your English Buddy" description="Artículos prácticos para mejorar tu inglés en situaciones cotidianas.">
  <Navbar client:load />
  <BlogSection client:visible posts={posts} />
  <Footer />
</BaseLayout>
