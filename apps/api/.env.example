# Copy to .env and fill in. Dev defaults shown.
# Local dev: `docker compose up -d` starts this Postgres (see docker-compose.yml).
DATABASE_URL="postgresql://eyb:eyb@localhost:5432/eyb?schema=public"
PORT=3001
# Comma-separated allowed origins for CORS (Astro dev = 4321).
WEB_ORIGIN="http://localhost:4321"

# Generate strong random secrets in production (e.g. `openssl rand -base64 48`).
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="7d"

# Leave empty in dev; set to your apex domain in prod for cross-subdomain cookies.
COOKIE_DOMAIN=""

# Single admin user, seeded/updated on boot.
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="change-me"
# Display name for the seeded admin (the panel falls back to the email if empty).
ADMIN_NAME=""
# Set to 1 to reset the admin password to ADMIN_PASSWORD on next boot.
ADMIN_RESET="0"

# Public base URL of this API — used to build absolute /uploads image URLs.
# Leave empty in dev (defaults to http://localhost:PORT); set in production,
# e.g. https://api.yourenglishbuddy.com
API_PUBLIC_URL=""
# Where uploaded images are stored. Defaults to <api>/uploads; point it at a
# persistent volume in production.
UPLOAD_DIR=""

# SMTP for transactional email (admin invitations + password resets).
# Leave SMTP_HOST empty in dev: emails are logged to the console instead,
# including the action link, so the flows stay testable.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Your English Buddy <no-reply@yourenglishbuddy.com>"
# Base URL of the admin panel used inside emailed links + the Google OAuth
# redirect-back target. Defaults to the first WEB_ORIGIN + /admin.
ADMIN_URL=""

# ─── Student portal ──────────────────────────────────────────────────────────
# Base URL of the student portal (currently informational). Defaults to the
# first WEB_ORIGIN + /portal.
PORTAL_URL=""

# Google Gemini powers the "Buddy" AI chat. Without a key the chat replies with
# a friendly "not configured" message and everything else keeps working.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"

# Google Calendar (booking free/busy + writing the confirmed class as an event).
# Create an OAuth 2.0 Client (Web application) in Google Cloud Console, enable
# the Google Calendar API, and add GOOGLE_REDIRECT_URI as an authorized redirect
# URI. Leave empty to keep booking working with local availability only.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Must exactly match an authorized redirect URI on the OAuth client.
# Defaults to <API_PUBLIC_URL or http://localhost:PORT>/admin/booking/google/callback.
GOOGLE_REDIRECT_URI=""
