// Prisma schema for the Your English Buddy content API.
//
// Scope: the blog is the only CMS-driven content (see the migration plan),
// so this schema holds just the BlogPost content table plus the admin auth
// tables (User + RefreshToken).
//
// PostgreSQL in every environment (dev via docker-compose, prod via a managed
// Postgres). `body` is stored as a JSON-serialized String — swap to `Json`
// (jsonb) later if you want in-DB querying; the service already serializes.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  // Display name; the UI falls back to the email when unset.
  name          String?
  // Profile picture URL (uploaded via /admin/uploads); initials shown when unset.
  avatarUrl     String?
  passwordHash  String
  role          String         @default("ADMIN")
  // Start of the current session and of the one before it — the dashboard
  // greets with prevLoginAt ("tu último acceso") so it survives reloads.
  lastLoginAt   DateTime?
  prevLoginAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  refreshTokens RefreshToken[]
  tokens        UserToken[]
  activity      ActivityLog[]
}

// Audit trail: one row per admin action (content edits, invitations, logins).
// userEmail is denormalized so history survives user deletion.
model ActivityLog {
  id        Int      @id @default(autoincrement())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId    String?
  userEmail String
  action    String // 'create' | 'update' | 'delete' | 'invite' | 'login' | …
  entity    String // 'page' | 'blog' | 'user' | 'upload' | 'auth'
  entityId  String?
  summary   String // human sentence shown in the admin timeline
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([entity, createdAt])
}

// Single-use, expiring tokens for admin invitations and password resets.
// Only the sha256 of the raw token is stored; the raw value travels once,
// inside the emailed link.
model UserToken {
  id        String    @id @default(cuid())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  type      String // 'INVITE' | 'RESET'
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, type])
}

model RefreshToken {
  id        String    @id @default(cuid())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// `body` is JSON-stringified (SQLite has no jsonb; Postgres promotion later
// keeps the same string serialization). Validation happens at the API
// boundary via class-validator DTOs. `image` is a stable path string
// (e.g. /blog-images/present-perfect.jpg) served as a static asset by the web
// app — intentionally decoupled from the frontend's Vite module graph.
// One JSON document per editable public page ('home' | 'about' | 'courses' |
// 'blog' | 'site'). `data` is JSON-stringified like BlogPost.body; the row is
// absent until the admin saves an override — the frontend then falls back to
// the canonical defaults in @eyb/shared.
model PageContent {
  key       String   @id
  data      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BlogPost {
  id        Int      @id @default(autoincrement())
  slug      String   @unique
  category  String
  title     String
  excerpt   String
  readTime  String
  level     String
  variant   String
  image     String
  body      String
  published Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, sortOrder])
}

// ─────────────────────────── Student portal ───────────────────────────
// A learner with portal access. Authenticates with a tutor-issued username +
// password (no email — password resets regenerate a temp password instead of
// emailing a link). `passwordHash` is bcrypt like User. Separate principal from
// the admin User: portal JWTs carry `typ: 'student'`.
model Student {
  id                 String         @id @default(cuid())
  name               String
  username           String         @unique
  passwordHash       String
  level              String // CEFR: 'A1' | 'A2' | 'B1' | 'B2' | 'C1'
  streakWeeks        Int            @default(0)
  // Forces the change-password screen on first login (tutor sets a temp password).
  mustChangePassword Boolean        @default(true)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  classes            StudentClass[]
  messages           ChatMessage[]
  bookings           Booking[]

  @@index([username])
}

// One registered class in a student's history. `topics`, `notes` and
// `materials` are JSON-stringified (same pattern as BlogPost.body):
//   topics:    string[]
//   notes:     { kind: 'p' | 'ex' | 'tip', text?, en?, es? }[]  (ordered)
//   materials: { type: 'pdf' | 'blog', title, url }[]
// `summary` is an optional short recap fed to the AI as the allowed scope.
model StudentClass {
  id        String   @id @default(cuid())
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId String
  num       Int
  date      DateTime
  title     String
  topics    String   @default("[]")
  notes     String   @default("[]")
  materials String   @default("[]")
  summary   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId, num])
}

// One message in a student's Buddy conversation. `from` is the author:
// 'student' (learner) | 'ai' (Buddy) | 'teacher' (tutor reply, shown distinct).
// `readByTeacher` drives the admin unread count — student messages start unread
// and are cleared when the tutor opens the thread.
model ChatMessage {
  id            String   @id @default(cuid())
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId     String
  from          String
  text          String
  readByTeacher Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([studentId, createdAt])
}

// A confirmed class booking. `googleEventId` links the mirrored Google Calendar
// event (created with the tutor's Zoom link) so it can be updated/removed.
model Booking {
  id            String   @id @default(cuid())
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId     String
  start         DateTime
  end           DateTime
  status        String   @default("confirmed") // 'confirmed' | 'cancelled'
  googleEventId String?
  createdAt     DateTime @default(now())

  @@index([start])
}

// Singleton config row (one tutor) for the portal's booking feature.
//   weeklyAvailability: { day: 0-6, on: boolean, ranges: { start, end }[] }[]
//   googleTokens: JSON OAuth tokens { access_token, refresh_token, expiry_date, scope }
model PortalSettings {
  id                 String   @id @default("singleton")
  bookingEnabled     Boolean  @default(false)
  zoomLink           String?
  weeklyAvailability String   @default("[]")
  googleConnected    Boolean  @default(false)
  googleEmail        String?
  googleTokens       String?
  updatedAt          DateTime @updatedAt
}
