{
  "name": "english-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm-run-all2 --parallel dev:api dev:web",
    "dev:web": "npm run dev -w @eyb/web",
    "dev:api": "npm run start:dev -w @eyb/api",
    "build": "npm run build -w @eyb/shared && npm run build -w @eyb/web",
    "build:api": "npm run build -w @eyb/shared && npm run build -w @eyb/api",
    "seed": "npm run seed -w @eyb/api",
    "seed:generate": "npm run seed:generate -w @eyb/api",
    "typecheck": "tsc -b",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "npm-run-all2": "^7.0.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4"
  }
}
